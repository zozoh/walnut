# atest.init — ATEST 静态夹具（ATESET-06 的 cmd_o 样例共用）
#
# 这里只写"世界应该长什么样"：~ 下先有一个 atest-lab 实验目录、一个 docs 子目录，
# 以及一个由模板渲染出来的 hello.txt。每例新增的业务数据写到 atest/scripts/<CASE-ID>.py。
#
# 怎么执行（ATESET-05 最终版）：
#   - 用例脚本第一行调 `atlib.fixture()`：它把本文件上传到 ~/.atest/init/，
#     再执行 `app init -conf ~/.atest/init/atest.init -script off`；
#   - 变量来自 atest/vars.json（本项目是 {"who": "walnut"}），经 `-vars` 传入；
#   - 幂等由 `app init` 保证（非空文件不覆盖），同一模板可重复执行。
#
# 写法与 `app init` 完全一致（见 man cmd_app_init）：
#   @DIR / @FILE / @API / @HOME / @ENV / @INCLUDE
#   %TMPL: / %COPY: / %EXPLAIN: ... %END%
# 注意：用 `%COPY >` 引用外部文件时，该文件必须与模板同目录上传。

# 实验目录与子目录（路径相对域 home，父目录由 atlib 自动建）
@DIR atest-lab
@DIR atest-lab/docs

# 由模板渲染的文本文件：内容随 vars.json 的 who 变化
@FILE atest-lab/hello.txt
%TMPL:
hello from atest
who: ${who}
%END%

#---------------------------------------------------------
# ATESET-09：regapi HTTP 通道样例
#
# 接口对象只在这里声明一次（用例脚本不负责造接口）：
#   路径相对域 home，`.regapi/api/<name>` 就是一个接口，
#   内容 = 命令模板，元数据 = 行为；对外 URL 是
#   `<实例地址>/api/<测试域>/<name>`。
# 快捷元数据（`@API ... 'cross/json'`）：
#   cross → http-cross-origin:"*"，json → Content-Type:"text/json"，
#   http302 → http-resp-code:302。
#---------------------------------------------------------

# CASE-201 普通 JSON 接口：GET /api/<域>/ping
@API .regapi/api/ping 'cross/json'
%COPY:
echo '{"ok":true,"msg":"pong"}'
%END%

# CASE-202 令牌保护：不带 ?at=<令牌> 一律 403。
# ⚠️ 元数据值是**请求元数据键**（http-qs-at），不是裸参数名：源码
# `ApiMetaFiller.checkApiAccessToken` 直接拿它去查 reqMeta，写 "at" 会永远取不到
# 而恒 403（wn-doc 里 "at" 的示例与源码不符，以源码为准）。令牌文件走默认位置。
@API .regapi/api/secret 'cross/json'
{"api-access-token": "http-qs-at"}

@FILE .domain/api_access_token
%COPY:
s3cr3t-atest
%END%

# CASE-203 302 跳转：stdout 就是目标 URL。
# 必须 `echo -n`：带换行时 Jetty 会把行尾换行写成 Location 的尾随空格。
@API .regapi/api/go 'http302'
%COPY:
echo -n 'http://example.com/atest'
%END%

# CASE-204 接口写对象：副作用落在 ~/atest-lab/api-side-effect.txt。
# `content` 是**元数据**不是文件内容；`-upsert` 让同一接口连跑多次不报"已存在"。
@API .regapi/api/write 'cross/json'
%COPY:
o @create -p ~/atest-lab -upsert '{"nm":"api-side-effect.txt","content":"from-api"}'
%END%

#---------------------------------------------------------
# ATESET-10：三层联动样例（HTTP → jsbin → 命令）
#
# 链路：POST /api/<测试域>/order/create?amount=N
#   → 接口内容 = `jsc ~/jsbin/order_flow.js -vars '{amount:"N"}'`
#     → 脚本里 $wn.exec 一条 `o @create`（-upsert 保证可重复执行）
#       → 对象落在 ~/atest-lab/orders/order-N.json
# 三层各管一段：接口对象只在夹具里声明，脚本只负责跑命令，
# 用例脚本只发 HTTP + 读对象（见 cases/CASE-301.md、CASE-302.md）。
#---------------------------------------------------------

# `o @create -p` 不会自建父目录（要 -auto），订单目录先由夹具铺好
@DIR atest-lab/orders

# jsbin 脚本必须是 ES5：nashorn 不支持 let / 箭头函数 / 模板串。
# 用 $wn.exec 而不是 sys.exec：前者把命令输出作为返回值（不进脚本 stdout），
# 否则 `o` 回显的对象 JSON 会混进 HTTP body，信封就不是单个 JSON 了；
# 而且 $wn.exec 遇到 `e.*` 会抛异常，命令失败不会伪装成成功。
@FILE jsbin/order_flow.js
%TMPL:
// ES5：nashorn 不支持 let/箭头函数
var amount = parseInt(amount || "0", 10);
var nm = "order-" + amount + ".json";
$wn.exec("o @create -p ~/atest-lab/orders -upsert '{\"nm\":\"" + nm + "\",\"amount\":" + amount + "}'");
$log.ajax_ok({orderNm: nm, amount: amount});
%END%

# 接口内容是一条命令模板：`${http-qs-amount?}` 缺省为空串（脚本按 0 处理）。
@API .regapi/api/order/create 'cross/json'
%COPY:
jsc ~/jsbin/order_flow.js -vars '{amount:"${http-qs-amount?}"}'
%END%
