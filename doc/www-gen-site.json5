{
  // Walnut 文档站点配置（www-gen-site）
  // 用法：www-gen-site "D:\workspace\git\github\zozoh\walnut\doc"
  site: {
    title: "Walnut 文档",
    description: "Walnut 项目文档：架构、存储与 IO、账户会话权限、命令体系等",
    keywords: ["walnut", "文档"],
    lang: "zh-CN",
    baseUrl: "/",
    favicon: "favicon.svg",
  },

  templates: {
    // dir: null,        // 模板主目录，null = 工具内置 templates/
    theme: "nice",       // 主题 = 模板主目录下的子目录名
  },

  build: {
    outputDir: "../dist/walnut-www",   // → <walnut>/dist/walnut-www
    // cacheDir: null,                  // 默认 <outputDir>/.www-gen-site-cache
    urlStyle: "flat",                  // 文档页输出为 xxx.html
    stripOrderPrefix: false,           // 保留 00- 01- 这类前缀在 URL 中
    excludeGlobs: [
      "_old/**",                       // 归档目录不参与站点生成
    ],
  },

  markdown: {
    gfm: true,
    highlight: true,
  },
}
